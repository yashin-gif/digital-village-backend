APP_NAME=Digital Village API
APP_VERSION=1.0.0

# ডেভেলপমেন্টে true (টোকেন/মেসেজ লগে দেখাবে)। প্রোডাকশনে false।
DEBUG=true

# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/digital_village
DATABASE_URL=sqlite:///./digital_village.db

# জেনারেট করুন: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ফ্রন্টএন্ডের ঠিকানা (JSON লিস্ট)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
